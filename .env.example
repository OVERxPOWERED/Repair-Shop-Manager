# Environment configuration for FixPro
# Copy this to .env for local development

# Django Settings
DEBUG=True
SECRET_KEY=fixpro-insecure-dev-key-change-in-production-^!7#8x9
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,capacitor://localhost,http://localhost

# Database Configuration (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=fixpro_db
DB_USER=fixpro_user
DB_PASSWORD=fixpro_dev_password
DB_HOST=localhost
DB_PORT=5432

# Sentry Error Reporting (Optional in Dev)
SENTRY_DSN=

# Mobile & External URLs
API_BASE_URL=http://localhost:8000/api/v1
PUBLIC_TRACKING_BASE_URL=http://localhost:8000/t/
