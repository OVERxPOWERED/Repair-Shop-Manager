{
  "name": "fixpro-frontend",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "next lint && pnpm i18n:check",
    "typecheck": "tsc --noEmit",
